

### Ejemplo base
POST http://localhost:3200/api/purchase/initialize-purchase
Content-Type: application/json

{
    "basicUserData": {
        "email": "elpepe@gmail.com",
        "name": "Pedro Sanchez",
        "docType": "CC",
        "identification": "0005",
        "telephone": "0312"
    },
    "addressData": {
        "departmentId": 1,
        "deliveryAddress": "Carrera del pepe",
        "zipCode": "0102"
    }, 
    "productList": [
        {
            "id": 1,
            "quantity": 3
        },
        {
            "id": 2,
            "quantity": 3
        }
    ]
}

